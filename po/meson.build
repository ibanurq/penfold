i18n.gettext(
  meson.project_name(),
  preset: 'glib',
  # Python's gettext functions for plurals and contexts, besides the C ones of the glib preset.
  args: [
    '--from-code=UTF-8',
    '--keyword=pgettext:1c,2',
    '--keyword=npgettext:1c,2,3',
    '--msgid-bugs-address=https://github.com/ibanurq/penfold/issues',
  ],
)
