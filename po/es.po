msgstr "Arrastra aquí un PDF para abrirlo, o varios para combinarlos"

#: data/ui/welcome_page.blp:28
msgid "_Merge…"
msgstr "_Combinar…"

#: data/ui/window.blp:42
msgid ""
"This PDF is protected against changes: Penfold cannot save it, print it or "
"extract pages from it yet."
msgstr ""
"Este PDF está protegido contra cambios: Penfold todavía no puede guardarlo, "
"imprimirlo ni extraer páginas."

