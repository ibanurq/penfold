<?xml version="1.0" encoding="UTF-8"?>
<!-- The app's card in software centers such as GNOME Software and Flathub (AppStream metadata) -->
<component type="desktop-application">
  <id>io.github.ibanurq.Penfold</id>
  <launchable type="desktop-id">io.github.ibanurq.Penfold.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name translate="no">Penfold</name>
  <summary>Read, annotate and organize PDFs</summary>
  <developer id="io.github.ibanurq">
    <name translate="no">ibanurq</name>
  </developer>
  <description>
    <p>Penfold is a simple PDF reader that can also add annotations and work with pages.</p>
    <ul>
      <li>Add pages from other PDFs, and blank pages</li>
      <li>Merge files into a single file</li>
      <li>Pages: reorder, extract, delete and rotate</li>
      <li>Bookmarks: add, rename and reorder</li>
      <li>Annotations: highlights, underlines (also squiggly) and strikethroughs</li>
      <li>Graphic elements: comments, text boxes, rectangles, circles, arrows, polylines, freehand drawings, images and stamps</li>
      <li>Forms: fill them in, and save them to keep editing later or flattened to send them</li>
    </ul>
    <p>Annotations are saved with their own drawing, so they look the same in other PDF viewers. Penfold works without an
      internet connection and never runs the code (JavaScript) that a PDF may contain.</p>
  </description>
  <categories>
    <category>Office</category>
  </categories>
  <keywords>
    <keyword translate="no">PDF</keyword>
    <keyword>annotate</keyword>
    <keyword>highlight</keyword>
    <keyword>merge</keyword>
  </keywords>
  <provides>
    <mediatype>application/pdf</mediatype>
    <binary>penfold</binary>
  </provides>
  <screenshots>
