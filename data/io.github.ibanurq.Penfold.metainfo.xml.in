  <url type="homepage">https://github.com/ibanurq/penfold</url>
  <url type="bugtracker">https://github.com/ibanurq/penfold/issues</url>
  <url type="donation">https://ko-fi.com/ibanurq</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.1.0-alpha.4" date="2026-11-28" type="development">
      <description>
        <p>Fourth alpha of Penfold 1.1: stamps, such as Approved or Draft, which can be put, moved, resized and changed, also those made in other programs.</p>
      </description>
    </release>
    <release version="1.1.0-alpha.3" date="2026-11-27" type="development">
      <description>
        <p>Third alpha of Penfold 1.1: images, which can be inserted, moved, resized and turned, also those made in other programs.</p>
      </description>
    </release>
    <release version="1.1.0-alpha.2" date="2026-11-27" type="development">
      <description>
        <p>Second alpha of Penfold 1.1: freehand drawings, also those made in other programs.</p>
      </description>
    </release>
    <release version="1.1.0-alpha.1" date="2026-11-27" type="development">
      <description>
        <p>First alpha of Penfold 1.1: squiggly underlines, also those made in other programs.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-11-26" type="stable">
      <description>
        <p>First stable version: read, annotate and organize PDFs, merge files, extract pages and fill in forms.</p>
      </description>
    </release>
  </releases>
</component>
