    </screenshot>
    <screenshot>
      <caption>Filling in a form</caption>
      <image>https://raw.githubusercontent.com/ibanurq/penfold/main/docs/images/forms.png</image>
    </screenshot>
    <screenshot>
      <caption>Merging PDFs</caption>
      <image>https://raw.githubusercontent.com/ibanurq/penfold/main/docs/images/merge_dialog.png</image>
    </screenshot>
