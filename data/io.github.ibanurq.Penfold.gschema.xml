<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="penfold">
  <schema id="io.github.ibanurq.Penfold" path="/io/github/ibanurq/Penfold/">
    <!-- A window without a document is always small; these keys hold the size it had with a document (D17). -->
    <key name="window-width" type="i">
      <default>1280</default>
      <summary>Window width with a document</summary>
    </key>
    <key name="window-height" type="i">
      <default>860</default>
      <summary>Window height with a document</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Whether the window with a document is maximized</summary>
    </key>
    <key name="sidebar-width" type="i">
      <default>300</default>
      <summary>Width of the side panel</summary>
    </key>
    <key name="thumbnail-size" type="i">
      <default>160</default>
      <summary>Width of the thumbnails in the Pages view, in pixels (D39)</summary>
    </key>
    <!-- The style chosen in the main menu (D62). -->
    <key name="style" type="s">
      <choices>
        <choice value="system"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>'system'</default>
      <summary>Style of the interface: follow the system, light or dark</summary>
    </key>
    <!-- Preferences (D60, D61). -->
    <key name="author-name" type="s">
      <default>''</default>
      <summary>Author of new annotations</summary>
      <description>Empty uses “Penfold”.</description>
    </key>
    <key name="respect-permissions" type="b">
      <default>true</default>
      <summary>Whether to respect the user access permissions of a PDF</summary>
    </key>
  </schema>
</schemalist>
