using Gtk 4.0;
using Adw 1;

translation-domain "penfold";

// Preferences (02-interfaz, 3.3; D61): one page, and every change applies and is kept at once.
template $PenfoldPreferencesDialog: Adw.PreferencesDialog {
  // Narrower than the default, so that two options do not look wide; the height follows the content.
  content-width: 460;

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: _("Annotations");

      // An entry row of its own, because Adw.EntryRow cannot show a hint when empty (07-fase-12, 8): the title is always
      // small on top, and the entry, without a frame, takes the width of the row under it (D84).
      Adw.PreferencesRow author_row {
        styles [
          "author-row",
        ]

        Box {
          orientation: vertical;

          Label author_title {
            label: _("Author");
            xalign: 0;

            styles [
              "author-title",
              "dim-label",
            ]
          }

          Gtk.Entry author_entry {
            styles [
              "author-entry",
            ]

            has-frame: false;
            hexpand: true;
            secondary-icon-name: "document-edit-symbolic";
            secondary-icon-activatable: false;

            accessibility {
              labelled-by: author_title;
            }
          }
        }
      }

      Adw.SwitchRow annotation_bar_row {
        title: _("Show Annotation Bar at Start");
      }
    }

    Adw.PreferencesGroup {
      title: _("Documents");

      Adw.SwitchRow permissions_row {
        title: _("Respect Document Permissions");
      }

      Adw.SwitchRow position_row {
        title: _("Remember Document Position");
      }

      Adw.SwitchRow last_document_row {
        title: _("Start With Last Document");
      }
    }
  }
}
