using Gtk 4.0;

translation-domain "penfold";

// Page box (02-interfaz, 3.4; D14): the label or number of the current page, and the position next to it.
template $PenfoldPageEntry: Box {
  spacing: 6;
  valign: center;

  Entry entry {
    width-chars: 4;
    max-width-chars: 6;
    xalign: 0.5;
    tooltip-text: _("Go to Page");
    activate => $_on_activate();

    accessibility {
      label: _("Page");
    }
  }

  Label position_label {
    styles [
      "dim-label",
      "numeric",
    ]
  }
}
