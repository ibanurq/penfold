using Gtk 4.0;
using Adw 1;

translation-domain "penfold";

template $PenfoldWindow: Adw.ApplicationWindow {
  title: "Penfold";
  default-width: 620;
  default-height: 600;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      MenuButton {
        icon-name: "open-menu-symbolic";
        menu-model: main_menu;
        primary: true;
        tooltip-text: _("Main Menu");
      }
    }

    content: $PenfoldWelcomePage {};
  };
}

menu main_menu {
  section {
    item {
      label: _("_Open…");
      action: "app.open";
    }

    item {
      label: _("_Merge PDFs…");
      action: "app.merge";
    }

    item {
      label: _("_New Window");
      action: "app.new-window";
    }
  }

  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Penfold");
      action: "app.about";
    }
  }
}
