using Gtk 4.0;
using Adw 1;

translation-domain "penfold";

template $PenfoldWindow: Adw.ApplicationWindow {
  title: "Penfold";
  default-width: 620;
  default-height: 600;

  content: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "welcome";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [end]
          MenuButton welcome_menu_button {
            icon-name: "open-menu-symbolic";
            primary: true;
            tooltip-text: _("Main Menu");
          }
        }

        content: $PenfoldWelcomePage {};
      };
    }

    StackPage {
      name: "document";

      child: Adw.ToolbarView {
        [top]
        $PenfoldDocumentHeader document_header {}

        // Fixed reminder for protected PDFs (D18).
        [top]
        Adw.Banner protected_banner {
          title: _("This PDF is protected against changes: Penfold cannot save it, print it or extract pages from it yet.");
        }

        content: Overlay {
          child: ScrolledWindow {
            child: $PenfoldDocumentView document_view {
              styles [
                "document-view",
              ]
            };
          };

          [overlay]
          $PenfoldZoomControls zoom_controls {}
        };
      };
    }
  };
}
