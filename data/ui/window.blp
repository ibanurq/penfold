using Gtk 4.0;
using Adw 1;
translation-domain "penfold";

template $PenfoldWindow: Adw.ApplicationWindow {
  title: "Penfold";
  default-width: 620;
  default-height: 600;

  content: Stack stack {
    transition-type: crossfade;
    // Only the page shown counts for the size of the window: the welcome page is small.
    hhomogeneous: false;
    vhomogeneous: false;

    StackPage {
      name: "welcome";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [end]
          MenuButton welcome_menu_button {
            icon-name: "open-menu-symbolic";
            primary: true;
            tooltip-text: _("Main Menu");
          }
        }

        content: $PenfoldWelcomePage {};
      };
    }

    StackPage {
      name: "document";

      // Brief messages, such as "Page deleted · Undo", at the bottom of the window.
      child: Adw.ToastOverlay toast_overlay {
        child: Adw.OverlaySplitView split_view {
          sidebar-width-fraction: 1;

          sidebar: $PenfoldSidebar sidebar {};

          content: Adw.ToolbarView {
            [top]
            $PenfoldDocumentHeader document_header {}

            content: Overlay document_overlay {
              child: ScrolledWindow {
                child: $PenfoldDocumentView document_view {
                  styles [
                    "document-view",
                  ]
                };
              };

              [overlay]
              $PenfoldZoomControls zoom_controls {}
            };
          };
        };
      };
    }
  };

  // In narrow windows the side panel goes over the document.
  Adw.Breakpoint {
    condition ("max-width: 720sp")

    setters {
      split_view.collapsed: true;
    }
  }
}
