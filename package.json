{
  "name": "penfold",
  "version": "0.6.0",
  "description": "Penfold — PDF editor: read, annotate and organise PDFs in the browser",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "fixtures": "node tests/make-fixtures.mjs",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "electron .",
    "icons": "node tools/make-icons.mjs",
    "dist": "electron-builder --linux deb && node tools/make-web-zip.mjs",
    "test:dist": "PENFOLD_APP=dist/linux-unpacked/penfold playwright test tests/electron.spec.mjs",
    "i18n": "node tools/i18n-check.mjs",
    "dist:web": "node tools/make-web-zip.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "prettier": "3.9.10"
  },
  "homepage": "https://github.com/ibanurq/penfold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibanurq/penfold.git"
  },
  "bugs": {
    "url": "https://github.com/ibanurq/penfold/issues"
  },
  "main": "electron/main.js",
  "productName": "Penfold",
  "desktopName": "penfold.desktop",
  "author": {
    "name": "ibanurq",
    "email": "355446728+ibanurq@users.noreply.github.com"
  }
}
